<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DOOM-Setup-v1.0.0</AssemblyName>
    <ApplicationIcon>Assets\DOOM.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Version & Assembly Metadata -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>DOOM Installer</Product>
    <Company>DOOM Project</Company>
    <Authors>DOOM Contributors</Authors>
    <Description>Installer for DOOM — Privacy-First Desktop AI Overlay for Windows 11</Description>
    <Copyright>Copyright © 2026 DOOM Contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\DOOM-v1.0.0-win-x64.zip" LogicalName="DOOM.Payload.zip" />
    <EmbeddedResource Include="Assets\DOOM.ico" LogicalName="DOOM.ico" />
  </ItemGroup>

</Project>

