<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DOOM.App</RootNamespace>
    <AssemblyName>DOOM</AssemblyName>
    <ApplicationIcon>Assets\DOOM.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Version & Assembly Metadata -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>DOOM</Product>
    <Company>DOOM Project</Company>
    <Authors>DOOM Contributors</Authors>
    <Description>DOOM — Privacy-First Desktop AI Overlay for Windows 11</Description>
    <Copyright>Copyright © 2026 DOOM Contributors</Copyright>
    <PackageId>DOOM.Windows</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DOOM.ico" />
    <Content Include="Assets\DOOM.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DOOM.Core\DOOM.Core.csproj" />
    <ProjectReference Include="..\DOOM.Services\DOOM.Services.csproj" />
    <ProjectReference Include="..\DOOM.Platform.Windows\DOOM.Platform.Windows.csproj" />
    <ProjectReference Include="..\DOOM.Presentation\DOOM.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>

